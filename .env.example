# Copy to .env and fill in what you need. Everything is optional: without
# keys, the matching "Connect" button is off and file imports still work.

# Where people reach Tastemate. Connect sign-ins come back to
# PUBLIC_URL/api/connect/<app>/callback, which must match the redirect URI
# registered with each app exactly. Locally, use 127.0.0.1 (Spotify doesn't
# accept "localhost") and open the app at that address too.
PUBLIC_URL=http://127.0.0.1:5173

# Spotify: https://developer.spotify.com/dashboard → Create app → Web API.
# Redirect URI: http://127.0.0.1:5173/api/connect/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Instagram: https://developers.facebook.com/apps → Create app → add the
# Instagram product ("API setup with Instagram login").
# Redirect URI: https://your-domain/api/connect/instagram/callback (Meta needs https)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Key that seals connected apps' tokens in the database (32 bytes, hex).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, one is made and kept in data/token.key.
TOKEN_KEY=

# PORT=3001
# DB_FILE=data/tastemate.db
